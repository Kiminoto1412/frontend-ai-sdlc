# Secret used to sign and verify JWTs. Required in production, minimum 32 characters.
# Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-generated-secret-of-at-least-32-chars

# Number of trusted proxies in front of the app. Leave unset when there is none:
# x-forwarded-for is attacker-controlled without a proxy, so the rate limiter
# keys on the account instead. Set to 1 behind a single reverse proxy/CDN.
TRUST_PROXY_HOPS=
